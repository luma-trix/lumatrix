# Copy to .env.local and fill in your own Supabase project values.
# Both are browser-side, publishable values protected by row-level security.
# NEVER put the service-role key, LiveKit API secret, or DB password here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Video-call subscription gate. OFF unless set to exactly '1'.
# When enabled, 1:1 video calls require an active row in public.subscriptions.
# Voice calls, messaging, Moments and group conferences are never gated.
# Requires: supabase/v19_subscriptions.sql + a `create-checkout` Edge Function.
VITE_PAYWALL_ENABLED=0
